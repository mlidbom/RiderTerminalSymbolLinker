<idea-plugin>
    <id>dev.magnus.claudesessions</id>
    <name>Claude Sessions</name>
    <vendor email="magnus.lidbom@gmail.com" url="https://github.com/mlidbom/RiderTerminalSymbolLinker">Magnus Lidbom</vendor>
    <description><![CDATA[
        Shows each project's <a href="https://www.anthropic.com/claude-code">Claude Code</a> sessions in Cloyd, the
        application beside the IDE with a window for each project: as a project opens, Cloyd shows its window, and every
        session that ran in it is back, in its folder.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- The platform's JNA, through which each project window goes back to its virtual desktop after a restart. -->
    <depends>com.intellij.modules.jna</depends>

    <!-- defaultExtensionNs, never defaultExtensionPointName: see the symbol linker's plugin.xml. -->
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="dev.magnus.claudesessions.cloyd.ShowTheProjectInCloyd"/>
        <postStartupActivity implementation="dev.magnus.claudesessions.api.LocalApiStartup"/>
        <postStartupActivity implementation="dev.magnus.claudesessions.windows.PutTheWindowBackOnItsDesktop"/>
        <!-- What the plugin tells the user, such as that Cloyd didn't show the project's window. -->
        <notificationGroup id="Claude Sessions" displayType="BALLOON"/>
        <!-- The development observation channel: it listens only where a system property asks it to, in the sandbox
             IDE of the development tools. -->
        <postStartupActivity implementation="dev.magnus.claudesessions.observation.ObservationStartup"/>
    </extensions>

    <actions>
        <!-- The way from the IDE to the project's window in Cloyd. Ctrl+Alt+Shift+Y was the IDE's session history picker's
             until 0.2.0, and opens Cloyd's picker in Cloyd's window: so pressed twice, it opens the history. -->
        <action id="dev.magnus.claudesessions.ShowTheProjectInCloyd" class="dev.magnus.claudesessions.cloyd.ShowTheProjectInCloydAction"
                text="Show the Project in Cloyd" description="Brings the project's window in Cloyd forward, or opens it when it was closed">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift Y"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="dev.magnus.claudesessions.windows.RecordTheWindowsDesktopsAsTheIdeExits" topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>
</idea-plugin>
