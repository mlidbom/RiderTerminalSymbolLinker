<idea-plugin>
    <id>dev.magnus.claudesessions</id>
    <name>Claude Sessions</name>
    <vendor email="magnus.lidbom@gmail.com" url="https://github.com/mlidbom/RiderTerminalSymbolLinker">Magnus Lidbom</vendor>
    <description><![CDATA[
        A tool window whose tabs each run a <a href="https://www.anthropic.com/claude-code">Claude Code</a> session,
        and which resumes them when the IDE restarts: every session that ran in it when the IDE closed is back in its
        tab, in its folder.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- The reworked terminal, whose terminals the tool window's tabs are. -->
    <depends>org.jetbrains.plugins.terminal</depends>
    <!-- The platform's JNA, through which the session history picker lets another IDE bring its window forward. -->
    <depends>com.intellij.modules.jna</depends>

    <!-- Where a tab's chat gets the Claude Code behind it: see ClaudeCodeBehindTheChatProvider. Only the sandbox's stand-in
         provides one today, so in every other IDE a tab shows its terminal alone. -->
    <extensionPoints>
        <extensionPoint qualifiedName="dev.magnus.claudesessions.claudeCodeBehindTheChat"
                        interface="dev.magnus.claudesessions.chat.claudecode.ClaudeCodeBehindTheChatProvider" dynamic="true"/>
    </extensionPoints>

    <!-- defaultExtensionNs, never defaultExtensionPointName: see the symbol linker's plugin.xml. -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Never doNotActivateOnStart: IntelliJ IDEA then hides the tool window at every start, even when it was open as
             the IDE closed. -->
        <toolWindow id="Claude Sessions" anchor="bottom" canCloseContents="true"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"
                    factoryClass="dev.magnus.claudesessions.ClaudeSessionsToolWindowFactory"/>
        <postStartupActivity implementation="dev.magnus.claudesessions.saving.ClaudeSessionsStartup"/>
        <!-- What the plugin tells the user, such as that the Claude tooling's hub speaks a protocol it doesn't know. -->
        <notificationGroup id="Claude Sessions" displayType="BALLOON"/>
        <!-- The development observation channel: it listens only where a system property asks it to, in the sandbox
             IDE of the development tools. -->
        <postStartupActivity implementation="dev.magnus.claudesessions.observation.ObservationStartup"/>
        <!-- The IDE's paste in a chat's input box: it knows what was pasted, and takes images. Every other editor's paste
             is the one it had. -->
        <editorActionHandler action="EditorPaste" implementationClass="dev.magnus.claudesessions.chat.messagebox.MessageBoxPasteHandler"
                             order="first"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <!-- The shortcut that switches between the chat and the terminal works in the terminal too. -->
        <allowedActionsProvider implementation="dev.magnus.claudesessions.chat.TheChatsActionsInTheTerminal"/>
    </extensions>

    <extensions defaultExtensionNs="dev.magnus.claudesessions">
        <!-- Only in the sandbox IDE of the development tools: a stand-in its specifications drive. -->
        <claudeCodeBehindTheChat implementation="dev.magnus.claudesessions.observation.StandInBehindTheChatInTheSandbox"/>
    </extensions>

    <applicationListeners>
        <listener class="dev.magnus.claudesessions.saving.SaveTheSessionsAsTheProjectCloses" topic="com.intellij.openapi.project.ProjectCloseListener"/>
        <listener class="dev.magnus.claudesessions.saving.SaveTheSessionsAsTheProjectCloses" topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="dev.magnus.claudesessions.reload.ParkTheTabsWhileThePluginReloads" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <actions>
        <action id="ClaudeSessions.NewSession"
                class="dev.magnus.claudesessions.newsession.NewClaudeSessionAction"
                text="New Claude Session…"
                description="Name a new Claude Code session, or leave it unnamed, and start it in a tab of the Claude Sessions tool window"
                icon="AllIcons.General.Add"/>
        <action id="ClaudeSessions.ResumeSession"
                class="dev.magnus.claudesessions.history.ResumeClaudeSessionAction"
                text="Resume a Claude Session…"
                description="Pick a Claude Code session from the history, and resume it in a tab of the Claude Sessions tool window"
                icon="AllIcons.Vcs.History">
            <!-- Free in the default keymap, both Visual Studio keymaps, and Magnus's own (2026-11-18). -->
            <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl alt Y"/>
        </action>
        <action id="ClaudeSessions.SwitchBetweenTheChatAndTheTerminal"
                class="dev.magnus.claudesessions.chat.SwitchBetweenTheChatAndTheTerminalAction"
                text="Switch Between the Chat and the Terminal"
                description="Show the Claude Sessions tab's terminal, with Claude Code's own UI, in place of its chat, or its chat in place of its terminal"
                icon="AllIcons.Nodes.Console">
            <!-- Free in the default keymap, both Visual Studio keymaps, and Magnus's own (2026-11-19). -->
            <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl alt Z"/>
        </action>
    </actions>
</idea-plugin>
