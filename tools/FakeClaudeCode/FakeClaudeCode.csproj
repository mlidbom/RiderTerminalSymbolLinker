<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Named claude, so that Claude Sessions in the sandbox finds it on the PATH as it finds Claude Code. -->
    <AssemblyName>claude</AssemblyName>
    <RootNamespace>FakeClaudeCode</RootNamespace>
    <!-- One folder, whatever the configuration, for the sandbox to put first on its PATH. -->
    <OutDir>$(MSBuildProjectDirectory)\bin\claude\</OutDir>
  </PropertyGroup>

</Project>
