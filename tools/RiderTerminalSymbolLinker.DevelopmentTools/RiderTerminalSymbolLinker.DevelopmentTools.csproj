<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RiderTerminalSymbolLinker.DevelopmentTools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Slions.VirtualDesktop" Version="6.9.2" />
    <PackageReference Include="Vanara.PInvoke.User32" Version="5.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built with the tools, for the sandbox to run in place of Claude Code: see FakeClaudeCode's Program. -->
    <ProjectReference Include="..\FakeClaudeCode\FakeClaudeCode.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
