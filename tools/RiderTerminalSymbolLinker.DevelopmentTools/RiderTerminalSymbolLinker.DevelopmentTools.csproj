<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RiderTerminalSymbolLinker.DevelopmentTools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Compze.Threading.Interprocess" Version="0.7.0-alpha" />
    <PackageReference Include="Slions.VirtualDesktop" Version="6.9.2" />
    <PackageReference Include="Vanara.PInvoke.User32" Version="5.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixture solution's source generator, for its DLL, which every copy of the fixture solution gets: see
         SandboxRider.CopyTheFixtureSolutionTo. -->
    <ProjectReference Include="..\..\tests\RiderTerminalSymbolLinker.FixtureSourceGenerator\RiderTerminalSymbolLinker.FixtureSourceGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the tooling's `hub sandbox start` prints, as the hub's contract types it: see SandboxHub. The contract's
         types are for its clients to compile in, as Cloyd does (~/.claude/dev_docs/the-hubs-local-api.md). -->
    <Compile Include="$(USERPROFILE)\.claude\src\ClaudeTooling.Hub.LocalApi.Contract\Sandboxes\SandboxHubStarted.cs" Link="HubLocalApiContract\Sandboxes\SandboxHubStarted.cs" />
    <!-- The hub's announcement, and how to read it: see HubsLocalApi. -->
    <Compile Include="$(USERPROFILE)\.claude\src\ClaudeTooling.Hub.LocalApi.Contract\WhatTheAnnouncementSays.cs" Link="HubLocalApiContract\WhatTheAnnouncementSays.cs" />
    <Compile Include="$(USERPROFILE)\.claude\src\ClaudeTooling.Hub.LocalApi.Contract\FileTheHubWritesWhole.cs" Link="HubLocalApiContract\FileTheHubWritesWhole.cs" />
  </ItemGroup>

</Project>
