<Project>
   <PropertyGroup>
      <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
   </PropertyGroup>

   <!-- Avalonia, at the versions MachineStallViewer, JAStudio and Deskmancer use. -->
   <ItemGroup>
      <PackageVersion Include="Avalonia" Version="12.1.5" />
      <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
      <PackageVersion Include="Avalonia.Headless" Version="12.1.5" />
      <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
      <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.1" />
      <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
      <PackageVersion Include="LiveMarkdown.Avalonia" Version="2.7.0" />
   </ItemGroup>

   <!-- The candidates for the TUI's host. -->
   <ItemGroup>
      <PackageVersion Include="Iciclecreek.Avalonia.Terminal" Version="4.1.4" />
      <PackageVersion Include="AgentSpace.Avalonia.XTerm" Version="0.1.7" />
   </ItemGroup>

   <!-- The session host protocol's sources, compiled in from ~/.claude/src, lock with Compze.Threading. -->
   <ItemGroup>
      <PackageVersion Include="Compze.Threading" Version="0.12.0-alpha" />
   </ItemGroup>

   <!-- Testing, at the versions the tooling uses. -->
   <ItemGroup>
      <PackageVersion Include="Compze.Must" Version="0.9.0-alpha" />
      <PackageVersion Include="Compze.xUnitBDD" Version="0.7.0-beta" />
      <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
      <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
      <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
   </ItemGroup>
</Project>
