<Project Sdk="Microsoft.NET.Sdk">
   <!-- Cloyd.exe: a window for each project, beside its IDE, showing the project's Claude Code sessions. -->
   <PropertyGroup>
      <OutputType>WinExe</OutputType>
      <RootNamespace>Cloyd</RootNamespace>
      <ApplicationManifest>app.manifest</ApplicationManifest>
      <!-- The version Cloyd/CHANGELOG.md's top section is about. -->
      <Version>0.1.0</Version>
      <!-- For starting the Cloyd application through CreateProcessW, as the hub is started: see StartingTheApplication. -->
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <!-- A terminal-only hub can run alongside a newer Cloyd. When its installed contract predates Codex Chat,
           build against the tooling checkout that also supplies the session-host protocol. An explicitly selected
           contract (e.g. an isolated sandbox build) always takes precedence. -->
      <InstalledHubContract>$(USERPROFILE)\.claude\bin\ClaudeTooling.Hub.LocalApi.Contract</InstalledHubContract>
      <TheHubsContract Condition="'$(TheHubsContract)' == '' and Exists('$(InstalledHubContract)\CodexChat\CodexChatItemDetails.cs')">$(InstalledHubContract)</TheHubsContract>
      <TheHubsContract Condition="'$(TheHubsContract)' == ''">$(USERPROFILE)\.claude\src\ClaudeTooling.Hub.LocalApi.Contract</TheHubsContract>
   </PropertyGroup>
   <ItemGroup>
      <PackageReference Include="Avalonia" />
      <PackageReference Include="Avalonia.Desktop" />
      <PackageReference Include="Avalonia.Themes.Fluent" />
      <PackageReference Include="Avalonia.AvaloniaEdit" />
      <PackageReference Include="Iciclecreek.Avalonia.Terminal" />
      <PackageReference Include="LiveMarkdown.Avalonia" />
      <PackageReference Include="Compze.Threading" />
      <PackageReference Include="Compze.Threading.Interprocess" />
   </ItemGroup>
   <ItemGroup>
      <!-- ASP.NET Core's web server, Kestrel, for Cloyd's local API, as the hub's local API is served. -->
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
   </ItemGroup>
   <ItemGroup>
      <!-- The hub's own types for what session hosts and their clients say to each other, as the hub and the attach
           client compile them. -->
      <Compile Include="$(USERPROFILE)\.claude\src\ClaudeTooling.SessionHost.Protocol\*.cs" Link="SessionHostProtocol\%(Filename)%(Extension)" />
      <!-- The hub's local API, its requests, answers and events, as the hub writes and reads them. -->
      <Compile Include="$(TheHubsContract)\**\*.cs"
               Exclude="$(TheHubsContract)\bin\**;$(TheHubsContract)\obj\**"
               Link="HubLocalApiContract\%(RecursiveDir)%(Filename)%(Extension)" />
   </ItemGroup>
   <ItemGroup>
      <InternalsVisibleTo Include="Cloyd.Specifications" />
   </ItemGroup>
</Project>
