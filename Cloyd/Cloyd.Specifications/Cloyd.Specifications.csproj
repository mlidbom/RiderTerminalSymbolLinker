<Project Sdk="Microsoft.NET.Sdk">
   <!-- Cloyd's specifications, on Avalonia's headless platform, in process: windows laid out and drawn with Skia, on no
        screen. -->
   <PropertyGroup>
      <IsPackable>false</IsPackable>
      <!-- For running Cloyd.exe in a job of the specifications' own: see JobOfAnIde. -->
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
   </PropertyGroup>
   <ItemGroup>
      <PackageReference Include="Avalonia.Headless" />
      <PackageReference Include="Compze.Must" />
      <PackageReference Include="Compze.xUnitBDD" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" />
      <PackageReference Include="xunit.v3.mtp-off" />
      <PackageReference Include="xunit.runner.visualstudio">
         <PrivateAssets>all</PrivateAssets>
         <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
   </ItemGroup>
   <ItemGroup>
      <ProjectReference Include="..\Cloyd\Cloyd.csproj" />
   </ItemGroup>
   <ItemGroup>
      <!-- The session the desktop app's pictures show, which the chat's specifications draw: see TheSampleSession. -->
      <None Include="..\..\dev_docs\cloyd-chat-specification\the-sample-session.jsonl" Link="TheSampleSession\the-sample-session.jsonl" CopyToOutputDirectory="PreserveNewest" />
      <!-- The program a specification runs in a session's shell: see ProgramTakingTheMouse. -->
      <None Update="TheSandbox\ProgramTakingTheMouse.ps1" CopyToOutputDirectory="PreserveNewest" />
   </ItemGroup>
</Project>
