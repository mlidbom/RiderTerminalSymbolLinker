# Project-local build toolchain (Temurin JDK 21 + Gradle 9.5) — large, machine-specific
.tooling/

# Gradle / build output
.gradle/
build/
out/
*.iml

# IntelliJ Platform Gradle Plugin caches (sandbox, local platform artifacts)
.intellijPlatform/

# Kotlin compiler daemon working dir
.kotlin/


# The C# development tools' and the fixture solution's build output
bin/
obj/

# The shared Claude config: a git worktree of the machine's one clone of it, ~/.claude/.claude-shared, which the
# SessionStart hook makes and keeps up to date
/.claude-shared

# What dotnet test --blame-hang leaves
TestResults/

# What a spike's runs leave in its folder, as in spikes/CloydSpike on the branch spike/dotnet-cloyd: its throwaway
# session's folder, and what its probe drew. They stay behind in the working tree when another branch is checked out.
spikes/*/scratch-session/
spikes/*/probe-output/
